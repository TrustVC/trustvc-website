# https://www.sanity.io/organizations/<orgid>/project/<projectid>/api
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Required for non-interactive `npm run deploy` / CI (no browser login).
# Create in https://www.sanity.io/manage → Project → API → Tokens (role with Studio deploy).
# GitHub Actions: repository secret SANITY_AUTH_TOKEN with the same token value.
SANITY_AUTH_TOKEN=