VITE_SUPPORT_API_BASE_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to disable GTM.
VITE_GTM_CONTAINER_ID=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable direct GA4 tracking.
VITE_GA4_TAG_ID=

# reCAPTCHA: site key (frontend).
# Must match API secret key server-side.
# In production, this must be set; do not allow verification bypass when missing.
VITE_RECAPTCHA_SITE_KEY=

# Optional: platform/environment for Jira (e.g. dev, staging, prod). Default: dev
VITE_PLATFORM=dev

VITE_MAGIC_API_KEY=
VITE_NETWORK_TYPE=mainnet
INFURA_API_KEY=

# Per-chain RPC overrides (key = chain ID)
# Mainnet
VITE_RPC_URL_1=
VITE_RPC_URL_137=
VITE_RPC_URL_50=
VITE_RPC_URL_101010=
VITE_RPC_URL_1338=

# Testnet
VITE_RPC_URL_11155111=
VITE_RPC_URL_80002=
VITE_RPC_URL_51=
VITE_RPC_URL_20180427=
VITE_RPC_URL_21002=

# Sanity CMS
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01
# Optional perspective: published | draft | raw
VITE_SANITY_PERSPECTIVE=published
VITE_SANITY_READ_TOKEN=
