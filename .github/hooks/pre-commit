#!/usr/bin/env node

/**
 * Pre-commit hook to run lint and format checks
 * Cross-platform compatible Node.js script
 * This will prevent commits if there are any linting errors or formatting issues
 */

import { execSync } from 'child_process'
import { exit } from 'process'

function runCommand(command, errorMessage, fixCommand) {
  try {
    console.log(`📋 Running: ${command}`)
    execSync(command, { stdio: 'inherit' })
    return true
  } catch (error) {
    console.error(`❌ ${errorMessage}`)
    if (fixCommand) {
      console.error(`💡 Run '${fixCommand}' to automatically fix issues.`)
    }
    return false
  }
}

console.log('🔍 Running pre-commit checks...\n')

// Run lint check
const lintPassed = runCommand(
  'npm run lint',
  'ESLint found errors or warnings. Commit aborted.',
  'npm run lint:fix'
)

if (!lintPassed) {
  exit(1)
}
// stage 2 prettier
const prettierPassed = runCommand(
  'npm run format:check',
  'Code formatting check failed. Commit aborted.',
  'npm run format'
)

if (!prettierPassed) {
  exit(1)
} 

console.log('\n✅ All checks passed! Proceeding with commit...')
exit(0)
